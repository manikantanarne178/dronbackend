# ==============================================================================
# DroneVision / AutoDCR Backend - Environment Variables
# Copy this file to .env and fill in your values before running.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Application
PROJECT_NAME=DroneVision API
ENVIRONMENT=production
DEBUG=false
PORT=8000

# PostgreSQL Database (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# JWT Authentication (required)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AutoDCR File Storage (optional - defaults to ./storage/autodcr/ if not set)
# Set to an absolute path if you want files stored outside the project directory
AUTODCR_STORAGE_ROOT=

# DWG Conversion (optional - path to ODA File Converter executable)
# Required only if DWG format upload support is needed
ODA_FILE_CONVERTER=

# CORS (optional - restrict origins in production)
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE_MB=100
